---
import BaseLayout from "../layouts/BaseLayout.astro";
import { MEDIA_APPEARANCES } from "../data/speaking";
import { AUTHOR } from "../site.config";

// Topics I speak on
const topics = [
  {
    title: "Building Human Capability in Southeast Asia",
    blurb:
      "How nations across the ASEAN 11 develop their people — through institutions, education systems, leadership, and culture. ASEAN is the only region with a formal HRD Declaration, and a laboratory for what regional development can look like.",
  },
  {
    title: "Global leadership development",
    blurb:
      "Leading across cultures, paradox, and complexity — drawing on adult-development research and cross-national fieldwork.",
  },
  {
    title: "The future of work",
    blurb:
      "Digitalization, hybrid work, gig economies, AI-augmented work — and what it does to learning and development inside organizations.",
  },
  {
    title: "HRD in fragile and conflict contexts",
    blurb:
      "Lessons from a decade of work with community-based organizations on the Thai-Myanmar border and inside Myanmar.",
  },
  {
    title: "Rigorous mixed-methods research in HRD",
    blurb:
      "For graduate programs and faculty audiences: research design, publication strategy, and the editorial process inside HRD's flagship journals.",
  },
];

const formats = [
  {
    label: "Keynotes",
    detail:
      "30–60 minutes, framed for academic, practitioner, or policy audiences.",
  },
  {
    label: "Workshops & professional development",
    detail:
      "Half-day or full-day sessions for graduate programs, HR teams, and L&D leaders. Custom-built around the host organization's questions.",
  },
  {
    label: "Panels & moderated discussions",
    detail:
      "Conference panels, university seminars, and policy roundtables — including moderation.",
  },
  {
    label: "Custom executive education",
    detail:
      "Co-designed programs for corporate L&D teams, development banks, foundations, and government agencies — typically focused on ASEAN human capital or global leadership.",
  },
  {
    label: "Advisory engagements",
    detail:
      "Short-term research advisory for organizations working on HRD, leadership development, or workforce strategy in Southeast Asia and adjacent regions.",
  },
  {
    label: "Journalist comment",
    detail:
      "Background or on-the-record commentary on HRD, leadership, and Southeast Asia / ASEAN stories. Same-day responses possible for breaking deadlines.",
  },
];

const selectedVenues = [
  "Academy of Human Resource Development (AHRD) — Americas",
  "Asian AHRD International Conference",
  "UFHRD International Conference (Dublin, Lisbon, Sheffield, Nottingham, Cork)",
  "American Association for Adult and Continuing Education (AAACE)",
  "American Evaluation Association (AEA)",
  "International Transformative Learning Conference (Siena)",
  "UNESCO-APEID International Conference (Bangkok)",
  "Carnegie Endowment for International Peace (Global Think Tank Town Hall)",
  "Chulalongkorn University · NIDA · Far Eastern University (Thailand)",
  "Al Akhawayn University (Morocco)",
  "Hanoi University of Business and Technology (Vietnam)",
];

const selectedMedia = MEDIA_APPEARANCES.filter((m) => m.url)
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0))
  .slice(0, 6);

function renderCitation(s: string) {
  return s.replace(/\*([^*]+)\*/g, "<em>$1</em>");
}
---

<BaseLayout
  title="Speaking & Advisory"
  description="Keynotes, workshops, custom executive programs, advisory engagements, and journalist comment by Oliver S. Crocco on HRD, leadership, and Southeast Asia."
>
  {/* HEADER */}
  <section class="border-b border-[var(--color-border)] paper-grain">
    <div class="wrap py-20 md:py-28">
      <p class="eyebrow mb-5">Speaking & advisory</p>
      <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight mb-6 max-w-3xl">
        Keynotes, custom programs, and journalist comment
      </h1>
      <p class="font-display text-xl text-[var(--color-text-muted)] leading-snug max-w-2xl mb-8">
        I speak to academic, practitioner, and policy audiences on HRD, leadership development, and Southeast Asia.
      </p>
      <a
        href={`mailto:${AUTHOR.email}?subject=Speaking%20inquiry`}
        class="btn btn-primary"
      >
        Inquire about a talk
      </a>
    </div>
  </section>

  {/* TOPICS */}
  <section class="border-b border-[var(--color-border)] bg-[var(--color-paper-warm)]">
    <div class="wrap py-20">
      <p class="eyebrow mb-4">What I talk about</p>
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-12 max-w-2xl">
        Five topic areas
      </h2>
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        {topics.map((t, i) => (
          <li class="border-t border-[var(--color-border-strong)] pt-5">
            <p class="text-[var(--color-gold)] font-mono text-xs mb-3">
              0{i + 1}
            </p>
            <h3 class="font-display text-xl font-semibold mb-2 leading-snug">
              {t.title}
            </h3>
            <p class="text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed">
              {t.blurb}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* FORMATS */}
  <section class="border-b border-[var(--color-border)]">
    <div class="wrap py-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <div class="md:col-span-4">
          <p class="eyebrow mb-4">Formats</p>
          <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-4 leading-tight">
            How the work is delivered
          </h2>
          <p class="text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed">
            All formats are scoped in conversation. There are no packages or set rates — each engagement is built around the host organization's question and audience.
          </p>
        </div>
        <div class="md:col-span-8">
          <ul class="divide-y divide-[var(--color-border)]">
            {formats.map((f) => (
              <li class="py-5">
                <p class="font-display text-xl text-[var(--color-text)] font-medium leading-snug mb-1">
                  {f.label}
                </p>
                <p class="text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed">
                  {f.detail}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* VENUES */}
  <section class="border-b border-[var(--color-border)] bg-[var(--color-paper-warm)]">
    <div class="wrap py-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <div class="md:col-span-4">
          <p class="eyebrow mb-4">Selected venues</p>
          <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-4 leading-tight">
            Where the work has been
          </h2>
          <p class="text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed">
            Talks, workshops, and panels at academic conferences, host institutions, and policy forums across 11 countries.
          </p>
        </div>
        <div class="md:col-span-8">
          <ul class="space-y-3">
            {selectedVenues.map((v) => (
              <li class="font-display text-lg text-[var(--color-text)] leading-snug">
                {v}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* MEDIA */}
  <section class="border-b border-[var(--color-border)]">
    <div class="wrap py-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <div class="md:col-span-4">
          <p class="eyebrow mb-4">In the press</p>
          <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-4 leading-tight">
            Selected media
          </h2>
          <p class="text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed">
            Coverage and commentary in <em>Forbes</em>, <em>The Boston Globe</em>, <em>Reader's Digest</em>, <em>HRM Asia</em>, podcasts, and trade press.
          </p>
        </div>
        <div class="md:col-span-8">
          <ol class="divide-y divide-[var(--color-border)]">
            {selectedMedia.map((m) => (
              <li class="py-4 grid grid-cols-12 gap-3 items-baseline">
                <span class="col-span-2 md:col-span-1 font-mono text-xs text-[var(--color-text-soft)]">
                  {m.year ?? "—"}
                </span>
                <div class="col-span-8 md:col-span-9">
                  <p
                    class="font-display text-[1rem] leading-snug text-[var(--color-text)]"
                    set:html={renderCitation(m.citation)}
                  />
                </div>
                <div class="col-span-2 md:col-span-2 text-right">
                  {m.url && (
                    <a
                      href={m.url}
                      class="text-sm text-[var(--color-ink)] tracking-tight no-underline whitespace-nowrap"
                    >
                      View →
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section>
    <div class="wrap py-20">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">Booking</p>
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-5">
          Inquire about a talk, program, or interview
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-8">
          For keynote, workshop, or panel invitations, custom executive programs, advisory engagements, journalist comment, or podcast appearances — please email me directly.
        </p>
        <a
          href={`mailto:${AUTHOR.email}?subject=Speaking%20inquiry`}
          class="btn btn-primary"
        >
          {AUTHOR.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
