---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { AUTHOR } from "../../site.config";
import { getCollection } from "astro:content";

const allNotes = await getCollection("notes", ({ data }) => !data.draft);
const notes = allNotes.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const isPrelaunch = notes.length === 0;

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

// Lane → color treatment. Sticking with the site's existing gold accent
// for all lanes for now; can introduce per-lane color later if desired.
const laneColor = "text-[var(--color-gold)]";
---

<BaseLayout
  title="Notes"
  description="Ideas, field notes from Southeast Asia, method, and reading — by Oliver S. Crocco. A couple of times a month."
>
  {/* HEADER */}
  <section class="border-b border-[var(--color-border)] paper-grain">
    <div class="wrap py-20 md:py-28">
      <p class="eyebrow mb-5">Notes</p>
      <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight mb-6 max-w-3xl leading-[1.05]">
        Notes
      </h1>
      <p class="font-display text-xl md:text-2xl text-[var(--color-text-muted)] leading-snug max-w-2xl italic">
        Shorter than an essay, longer than a thought — ideas, field notes from the region, method, and reading. A couple of times a month.
      </p>
    </div>
  </section>

  {/* INDEX or PRE-LAUNCH STATE */}
  {isPrelaunch ? (
    <section class="border-b border-[var(--color-border)]">
      <div class="wrap-narrow py-20">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-gold)] mb-6">
          The four lanes
        </p>
        <ul class="list-none m-0 p-0 space-y-5">
          <li>
            <p class="font-display text-xl text-[var(--color-text)] leading-snug">
              <span class="font-mono text-xs uppercase tracking-[0.12em] text-[var(--color-gold)] mr-3">Ideas</span>
              Arguments and conversation warm-ups — where the channel earns its keep.
            </p>
          </li>
          <li>
            <p class="font-display text-xl text-[var(--color-text)] leading-snug">
              <span class="font-mono text-xs uppercase tracking-[0.12em] text-[var(--color-gold)] mr-3">Region</span>
              Southeast Asia field notes — what shows up between conferences and journal pages.
            </p>
          </li>
          <li>
            <p class="font-display text-xl text-[var(--color-text)] leading-snug">
              <span class="font-mono text-xs uppercase tracking-[0.12em] text-[var(--color-gold)] mr-3">Method</span>
              How the research actually gets done — including the role of AI in serious scholarship.
            </p>
          </li>
          <li>
            <p class="font-display text-xl text-[var(--color-text)] leading-snug">
              <span class="font-mono text-xs uppercase tracking-[0.12em] text-[var(--color-gold)] mr-3">Reading</span>
              Short notes on books worth more than a tweet.
            </p>
          </li>
        </ul>
        <p class="text-[var(--color-text-muted)] text-[1.0625rem] leading-relaxed mt-10 italic">
          First pieces publishing soon. Subscribe via RSS below to catch them as they land.
        </p>
      </div>
    </section>
  ) : (
    <section class="border-b border-[var(--color-border)]">
      <div class="wrap-narrow py-16">
        <ul class="list-none m-0 p-0">
          {notes.map((note) => (
            <li class="py-7 border-t border-[var(--color-border)] first:border-t-0">
              <div class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-[var(--color-text-soft)] flex items-center gap-4 mb-2">
                <span class={`${laneColor} font-medium`}>{note.data.lane}</span>
                <span>{formatDate(note.data.date)}</span>
              </div>
              <h2 class="font-display text-2xl md:text-[1.75rem] font-semibold leading-[1.2] tracking-tight mb-2">
                <a
                  href={`/notes/${note.id}/`}
                  class="text-[var(--color-text)] hover:text-[var(--color-ink)] no-underline"
                >
                  {note.data.title}
                </a>
              </h2>
              {note.data.dek && (
                <p class="text-[var(--color-text-muted)] text-[1.0625rem] leading-relaxed mt-2">
                  {note.data.dek}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* QUIET SUBSCRIBE BLOCK */}
  <section>
    <div class="wrap-narrow py-16">
      <div class="bg-[var(--color-paper-warm)] border border-[var(--color-border)] rounded-sm p-8 md:p-10">
        <p class="font-display text-xl font-medium mb-5">Follow along</p>
        <p class="text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed mb-3">
          <span class="text-[var(--color-text)] font-medium">Subscribe by RSS</span> — add the feed to Feedly, NetNewsWire, Inoreader, or any RSS reader:
        </p>
        <p class="font-mono text-[0.875rem] mb-6">
          <a href="/notes/rss.xml" class="text-[var(--color-ink)] break-all">
            olivercrocco.com/notes/rss.xml
          </a>
        </p>
        <p class="text-[var(--color-text-muted)] text-[0.875rem] leading-relaxed">
          Email subscription is on the way. In the meantime, drop a line to
          <a href={`mailto:${AUTHOR.email}?subject=Notes%20list`} class="text-[var(--color-ink)] ml-1">
            {AUTHOR.email}
          </a>{" "}
          and I'll add you when it launches.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
