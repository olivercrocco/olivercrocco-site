---
import BaseLayout from "../layouts/BaseLayout.astro";
import registry from "../data/poetry-of-work.json";

// Accounts for the project.
const ACCOUNTS = [
  { label: "LinkedIn", href: "https://www.linkedin.com/company/the-poetry-of-work/" },
];

// The poems come from src/data/poetry-of-work.json, generated by
// scripts/build-poetry-registry.mjs from the caption files and card images that
// actually go out on social (`npm run poetry:build`). Nothing is listed here by
// hand, so the page can never drift from the posts.
//
// A week appears only once its goLive has passed, so scheduled-but-unposted
// weeks stay off the page. That test runs at BUILD time: the site is static, so
// a new week shows up on the next deploy, not on its own each Monday.
const now = Date.now();
const posts = registry.weeks
  .filter((w) => Date.parse(w.goLive) <= now)
  .sort((a, b) => b.week - a.week);

// The newest post is featured; everything else becomes the archive.
const current = posts[0];
const archive = posts.slice(1);
---

<BaseLayout
  title="The Poetry of Work"
  description="A weekly public-domain poem on work, craft, and vocation. Curated by Oliver S. Crocco."
  image={current.cards[0]}
>
  {/* HERO */}
  <section class="border-b border-[var(--color-border)] paper-grain">
    <div class="wrap py-20 md:py-28">
      <p class="eyebrow mb-5">A weekly poem</p>
      <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight mb-8 leading-[1.05]">
        The Poetry of Work
      </h1>
      <p class="font-display text-xl md:text-2xl text-[var(--color-text-muted)] leading-snug max-w-3xl">
        Public-domain poems on work, craft, and vocation. A quiet pause in the working day.
      </p>
    </div>
  </section>

  {/* INTRO */}
  <section class="border-b border-[var(--color-border)]">
    <div class="wrap py-16 md:py-20">
      <div class="prose max-w-3xl" data-fade>
        <p class="drop-cap">
          People have long turned to poetry to make sense of their working lives, the hard parts and the good. This is a small weekly gathering of those poems, drawn entirely from the public domain: voices from across the centuries on labor and craft, the sea and the land, vocation and rest.
        </p>
        <p>
          Work keeps changing, and quickly. Sitting for a moment with how earlier generations wrote about it is one way to keep the human part of it close. Each week brings one poem, paired with a public-domain photograph, posted on LinkedIn.
        </p>
        <p>
          The project is curated by <a href="/about">Oliver S. Crocco</a>, a professor of leadership and human resource development, with care taken to get the sources and the public-domain status right.
        </p>
      </div>
    </div>
  </section>

  {/* THIS WEEK */}
  <section class="border-b border-[var(--color-border)]">
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow mb-3">This week</p>
      <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight mb-8">
        {current.poet}, &ldquo;{current.title}&rdquo;
      </h2>
      <p class="text-[var(--color-text-muted)] text-[0.9375rem] mb-5">Select a card to read it full size.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6" data-fade-stagger>
        {current.cards.map((src, i) => (
          <button type="button" class="pow-card block w-full p-0 bg-transparent border-0 cursor-zoom-in" data-group={`w${current.week}`}>
            <img
              src={src}
              alt={`${current.poet}, ${current.title}, card ${i + 1} of ${current.cards.length}`}
              loading="lazy"
              class="w-full aspect-[4/5] object-cover rounded border border-[var(--color-border-strong)] shadow-sm"
            />
          </button>
        ))}
      </div>
      <div class="text-[var(--color-text-muted)] text-[0.9375rem] space-y-1.5 max-w-3xl">
        <p class="eyebrow mb-2">Sources</p>
        <p>{current.poemCredit}</p>
        <p>{current.photoCredit}</p>
      </div>
    </div>
  </section>

  {/* ARCHIVE — past poems stay on the page; each expands to its cards and sources */}
  {archive.length > 0 && (
    <section class="border-b border-[var(--color-border)]">
      <div class="wrap py-16 md:py-20">
        <p class="eyebrow mb-3">Archive</p>
        <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight mb-8">
          Past poems
        </h2>
        <ul class="list-none m-0 p-0 divide-y divide-[var(--color-border)]">
          {archive.map((post) => (
            <li>
              <details class="group py-5">
                <summary class="flex items-center gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <span class="font-display text-lg md:text-xl text-[var(--color-text)] leading-snug">
                    {post.poet}, &ldquo;{post.title}&rdquo;
                  </span>
                  <span
                    class="text-[var(--color-gold)] text-sm ml-auto shrink-0 transition-transform group-open:rotate-90"
                    aria-hidden="true"
                  >→</span>
                </summary>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-6 mb-4">
                  {post.cards.map((src, i) => (
                    <button type="button" class="pow-card block w-full p-0 bg-transparent border-0 cursor-zoom-in" data-group={`w${post.week}`}>
                      <img
                        src={src}
                        alt={`${post.poet}, ${post.title}, card ${i + 1} of ${post.cards.length}`}
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover rounded border border-[var(--color-border-strong)] shadow-sm"
                      />
                    </button>
                  ))}
                </div>
                <div class="text-[var(--color-text-muted)] text-[0.875rem] space-y-1 max-w-3xl">
                  <p>{post.poemCredit}</p>
                  <p>{post.photoCredit}</p>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* FOLLOW */}
  <section>
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow mb-3">Follow along</p>
      <p class="text-[var(--color-text-muted)] mb-6 max-w-2xl">
        A new poem each week.
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-3">
        {ACCOUNTS.map((a) => (
          <li>
            <a href={a.href} class="text-[var(--color-ink)] underline underline-offset-4">{a.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  {/* LIGHTBOX: a selected card opens full size; arrows or swipe move through that poem's cards */}
  <dialog id="pow-lightbox" class="pow-lightbox" aria-label="Poem card, full size">
    <div class="pow-lightbox-inner">
      <img id="pow-lightbox-img" src="" alt="" />
      <button type="button" class="pow-lb-btn pow-lb-close" data-lb="close" aria-label="Close">&times;</button>
      <button type="button" class="pow-lb-btn pow-lb-prev" data-lb="prev" aria-label="Previous card">&lsaquo;</button>
      <button type="button" class="pow-lb-btn pow-lb-next" data-lb="next" aria-label="Next card">&rsaquo;</button>
      <p id="pow-lightbox-count" class="pow-lb-count"></p>
    </div>
  </dialog>

  <style>
    .pow-card:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 4px; border-radius: 0.25rem; }
    .pow-card img { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .pow-card:hover img { transform: translateY(-2px); box-shadow: 0 8px 24px rgb(0 0 0 / 0.12); }
    .pow-lightbox { padding: 0; border: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; margin: 0; }
    .pow-lightbox::backdrop { background: rgb(20 16 12 / 0.9); }
    .pow-lightbox-inner { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 3.5rem 1rem; }
    .pow-lightbox img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border-radius: 0.25rem; box-shadow: 0 10px 40px rgb(0 0 0 / 0.5); }
    .pow-lb-btn { position: absolute; color: #fff; background: rgb(0 0 0 / 0.45); border: 0; border-radius: 9999px; width: 2.75rem; height: 2.75rem; font-size: 1.75rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .pow-lb-btn:hover, .pow-lb-btn:focus-visible { background: rgb(0 0 0 / 0.7); }
    .pow-lb-close { top: 0.75rem; right: 0.75rem; }
    .pow-lb-prev { left: 0.75rem; top: 50%; transform: translateY(-50%); }
    .pow-lb-next { right: 0.75rem; top: 50%; transform: translateY(-50%); }
    .pow-lb-count { position: absolute; bottom: 1rem; left: 0; right: 0; text-align: center; color: rgb(255 255 255 / 0.8); font-size: 0.875rem; margin: 0; }
  </style>

  <script>
    const dialog = document.getElementById("pow-lightbox") as HTMLDialogElement | null;
    const img = document.getElementById("pow-lightbox-img") as HTMLImageElement | null;
    const count = document.getElementById("pow-lightbox-count");
    let group: HTMLImageElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    function show(i: number) {
      if (!img || !count || group.length === 0) return;
      index = (i + group.length) % group.length;
      img.src = group[index].currentSrc || group[index].src;
      img.alt = group[index].alt;
      count.textContent = `${index + 1} of ${group.length}`;
    }

    if (dialog && img) {
      document.querySelectorAll<HTMLButtonElement>(".pow-card").forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = btn.dataset.group;
          const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(`.pow-card[data-group="${key}"]`));
          group = buttons.map((b) => b.querySelector("img")!);
          opener = btn;
          show(buttons.indexOf(btn));
          dialog.showModal();
        });
      });

      dialog.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        const action = t.closest<HTMLElement>("[data-lb]")?.dataset.lb;
        if (action === "prev") show(index - 1);
        else if (action === "next") show(index + 1);
        else if (action === "close" || t === dialog || t.classList.contains("pow-lightbox-inner")) dialog.close();
      });

      dialog.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(index - 1);
        if (e.key === "ArrowRight") show(index + 1);
      });

      let startX = 0;
      dialog.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
      dialog.addEventListener("touchend", (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(dx < 0 ? index + 1 : index - 1);
      });

      dialog.addEventListener("close", () => opener?.focus());
    }
  </script>
</BaseLayout>
