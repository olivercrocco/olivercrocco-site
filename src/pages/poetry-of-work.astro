---
import BaseLayout from "../layouts/BaseLayout.astro";
import registry from "../data/poetry-of-work.json";

// Accounts for the project.
const ACCOUNTS = [
  { label: "Instagram", href: "https://www.instagram.com/poetryofwork/" },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/the-poetry-of-work/" },
];

// The poems come from src/data/poetry-of-work.json, generated by
// scripts/build-poetry-registry.mjs from the caption files and card images that
// actually go out on social (`npm run poetry:build`). Nothing is listed here by
// hand, so the page can never drift from the posts.
//
// A week appears only once its goLive has passed, so scheduled-but-unposted
// weeks stay off the page. That test runs at BUILD time: the site is static, so
// a new week shows up on the next deploy, not on its own each Monday.
const now = Date.now();
const posts = registry.weeks
  .filter((w) => Date.parse(w.goLive) <= now)
  .sort((a, b) => b.week - a.week);

// The newest post is featured; everything else becomes the archive.
const current = posts[0];
const archive = posts.slice(1);
---

<BaseLayout
  title="The Poetry of Work"
  description="A weekly public-domain poem on work, craft, and vocation. Curated by Oliver S. Crocco."
  image={current.cards[0]}
>
  {/* HERO */}
  <section class="border-b border-[var(--color-border)] paper-grain">
    <div class="wrap py-20 md:py-28">
      <p class="eyebrow mb-5">A weekly poem</p>
      <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight mb-8 leading-[1.05]">
        The Poetry of Work
      </h1>
      <p class="font-display text-xl md:text-2xl text-[var(--color-text-muted)] leading-snug max-w-3xl">
        Public-domain poems on work, craft, and vocation. A quiet pause in the working day.
      </p>
    </div>
  </section>

  {/* INTRO */}
  <section class="border-b border-[var(--color-border)]">
    <div class="wrap py-16 md:py-20">
      <div class="prose max-w-3xl" data-fade>
        <p class="drop-cap">
          People have long turned to poetry to make sense of their working lives, the hard parts and the good. This is a small weekly gathering of those poems, drawn entirely from the public domain: voices from across the centuries on labor and craft, the sea and the land, vocation and rest.
        </p>
        <p>
          Work keeps changing, and quickly. Sitting for a moment with how earlier generations wrote about it is one way to keep the human part of it close. Each week brings one poem, paired with a public-domain photograph, posted on Instagram and LinkedIn.
        </p>
        <p>
          The project is curated by <a href="/about">Oliver S. Crocco</a>, a professor of leadership and human resource development, with care taken to get the sources and the public-domain status right.
        </p>
      </div>
    </div>
  </section>

  {/* THIS WEEK */}
  <section class="border-b border-[var(--color-border)]">
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow mb-3">This week</p>
      <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight mb-8">
        {current.poet}, &ldquo;{current.title}&rdquo;
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6" data-fade-stagger>
        {current.cards.map((src, i) => (
          <img
            src={src}
            alt={`${current.poet}, ${current.title}, card ${i + 1} of ${current.cards.length}`}
            loading="lazy"
            class="w-full aspect-[4/5] object-cover rounded border border-[var(--color-border-strong)] shadow-sm"
          />
        ))}
      </div>
      <div class="text-[var(--color-text-muted)] text-[0.9375rem] space-y-1.5 max-w-3xl">
        <p class="eyebrow mb-2">Sources</p>
        <p>{current.poemCredit}</p>
        <p>{current.photoCredit}</p>
      </div>
    </div>
  </section>

  {/* ARCHIVE — past poems stay on the page; each expands to its cards and sources */}
  {archive.length > 0 && (
    <section class="border-b border-[var(--color-border)]">
      <div class="wrap py-16 md:py-20">
        <p class="eyebrow mb-3">Archive</p>
        <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight mb-8">
          Past poems
        </h2>
        <ul class="list-none m-0 p-0 divide-y divide-[var(--color-border)]">
          {archive.map((post) => (
            <li>
              <details class="group py-5">
                <summary class="flex items-center gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <span class="font-display text-lg md:text-xl text-[var(--color-text)] leading-snug">
                    {post.poet}, &ldquo;{post.title}&rdquo;
                  </span>
                  <span
                    class="text-[var(--color-gold)] text-sm ml-auto shrink-0 transition-transform group-open:rotate-90"
                    aria-hidden="true"
                  >→</span>
                </summary>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 mb-4">
                  {post.cards.map((src, i) => (
                    <img
                      src={src}
                      alt={`${post.poet}, ${post.title}, card ${i + 1} of ${post.cards.length}`}
                      loading="lazy"
                      class="w-full aspect-[4/5] object-cover rounded border border-[var(--color-border-strong)] shadow-sm"
                    />
                  ))}
                </div>
                <div class="text-[var(--color-text-muted)] text-[0.875rem] space-y-1 max-w-3xl">
                  <p>{post.poemCredit}</p>
                  <p>{post.photoCredit}</p>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* FOLLOW */}
  <section>
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow mb-3">Follow along</p>
      <p class="text-[var(--color-text-muted)] mb-6 max-w-2xl">
        A new poem each week. Follow wherever you keep your quiet corners of the day.
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-3">
        {ACCOUNTS.map((a) => (
          <li>
            <a href={a.href} class="text-[var(--color-ink)] underline underline-offset-4">{a.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
