/**
 * JSON-LD ScholarlyArticle schema for each selected publication.
 * Parses the canonical APA-ish citation string into structured fields:
 * authors (split on commas/&), year (regex), title (between year and venue).
 * The note field is dropped — schema is for machines, note is for humans.
 */
function parseCitation(citation: string, venue: string) {
  const yearMatch = citation.match(/\((\d{4})\)/);
  const year = yearMatch ? parseInt(yearMatch[1], 10) : null;
  // Authors come before the (YYYY)
  const authorsPart = yearMatch
    ? citation.slice(0, yearMatch.index).trim().replace(/[.,\s]+$/, "")
    : "";
  const authors = authorsPart
    .split(/(?<=\.),\s*(?:&\s*)?|\s*&\s*/)
    .map((a) => a.trim())
    .filter((a) => a.length > 0);
  // Title comes after the year, before the venue (italicized journal name)
  const afterYear = yearMatch
    ? citation.slice((yearMatch.index ?? 0) + yearMatch[0].length).replace(/^\.\s*/, "")
    : citation;
  // Title ends at first period followed by space + capital, roughly
  const titleMatch = afterYear.match(/^([^.]+\.)/);
  const title = titleMatch ? titleMatch[1].replace(/\.$/, "").trim() : afterYear;
  // Journal name = first comma-separated chunk of venue (strip volume/pages)
  const journal = venue.split(",")[0].trim();
  return { year, authors, title, journal };
}

const allPubs = Object.values(selected).flat();
const publicationsGraph = {
  "@context": "https://schema.org",
  "@graph": allPubs.map((p) => {
    const { year, authors, title, journal } = parseCitation(p.citation, p.venue);
    return {
      "@type": "ScholarlyArticle",
      headline: title,
      author: authors.map((name) => ({ "@type": "Person", name })),
      ...(year ? { datePublished: String(year) } : {}),
      isPartOf: {
        "@type": "Periodical",
        name: journal,
      },
      url: p.url,
      ...(p.url.includes("doi.org")
        ? {
            sameAs: p.url,
            identifier: {
              "@type": "PropertyValue",
              propertyID: "doi",
              value: p.url.replace(/^https?:\/\/(dx\.)?doi\.org\//, ""),
            },
          }
        : {}),
    };
  }),
};
---

<BaseLayout
  title="Selected Publications"
  description="Selected articles and chapters by Oliver S. Crocco on human capability in Southeast Asia, global leadership and adult learning, and the changing nature of work."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(publicationsGraph)} />

  {/* HEADER */}
  <section class="border-b border-[var(--color-border)] paper-grain">
    <div class="wrap py-20 md:py-28">
      <p class="eyebrow mb-5">Publications</p>
      <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight mb-6 max-w-3xl">
        Selected publications
      </h1>
      <p class="font-display text-xl text-[var(--color-text-muted)] leading-snug max-w-2xl mb-8">
        A selection across my three research streams, starting with Southeast Asia. The full record of 50+ scholarly publications lives on Google Scholar and ORCID.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={SOCIAL.googleScholar} class="btn btn-primary">Google Scholar →</a>
        <a href={SOCIAL.orcid} class="btn btn-ghost">ORCID →</a>
        <a
          href="https://www.dropbox.com/scl/fi/8e451lgbxa85tgupyxwuu/Oliver-S.-Crocco_CV.docx?rlkey=7ibodut9wc9k3jgw2o1jc743c&st=xz46bcsn&dl=0"
          class="btn btn-ghost"
        >
          Download CV
        </a>
      </div>
    </div>
  </section>

  {/* SELECTED PUBLICATIONS BY THEME */}
  <section>
    <div class="wrap py-20">
      {Object.entries(selected).map(([theme, pubs], themeIdx) => (
        <div class="mb-20">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-10 items-end">
            <div class="md:col-span-1">
              <span class="font-mono text-sm text-[var(--color-gold)]">
                0{themeIdx + 1}
              </span>
            </div>
            <h2 class="md:col-span-11 font-display text-2xl md:text-3xl font-semibold tracking-tight pb-4 border-b border-[var(--color-border-strong)] leading-tight">
              {theme}
            </h2>
          </div>

          <ol class="divide-y divide-[var(--color-border)]">
            {pubs.map((p) => (
              <li class="py-8 grid grid-cols-1 md:grid-cols-12 gap-6">
                <div class="md:col-span-8">
                  <p class="font-display text-[1.0625rem] leading-snug text-[var(--color-text)] mb-2">
                    {p.citation}
                  </p>
                  <p class="text-sm italic text-[var(--color-text-muted)] mb-3">
                    {p.venue}
                  </p>
                  {p.award && (
                    <p class="text-xs uppercase tracking-wider text-[var(--color-gold)] font-medium mb-3">
                      ★ {p.awardUrl ? <a href={p.awardUrl}>{p.award}</a> : p.award}
                    </p>
                  )}
                  <a
                    href={p.url}
                    class="text-sm text-[var(--color-ink)] tracking-tight font-mono break-all"
                  >
                    {p.url.replace(/^https?:\/\//, "")}
                  </a>
                </div>
                {p.note && (
                  <div class="md:col-span-4 md:border-l md:border-[var(--color-border-strong)] md:pl-6">
                    <p class="text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed">
                      {p.note}
                    </p>
                  </div>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  {/* CTA — bottom */}
  <section class="border-t border-[var(--color-border)] bg-[var(--color-paper-warm)]">
    <div class="wrap py-20">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-semibold tracking-tight mb-4">
          Looking for the full list?
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-8">
          The complete and current record of articles, chapters, reviews, and conference work is maintained automatically on Google Scholar and ORCID, and the full annotated record sits in my CV.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={SOCIAL.googleScholar} class="btn btn-primary">Google Scholar →</a>
          <a href={SOCIAL.orcid} class="btn btn-ghost">ORCID →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
