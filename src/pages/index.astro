---
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR, SITE, RESEARCH_THEMES } from "../site.config";
import Fleuron from "../components/Fleuron.astro";
import StreamsBraid from "../components/StreamsBraid.astro";
import PersonSchema from "../components/PersonSchema.astro";

// Selected publications — top 5 most prominent recent.
const featuredPubs = [
  {
    citation:
      "Crocco, O. S., Mohd Rasdi, R., & Garavan, T. N. (2026). Responsible AI in non-empirical research: Guidance for authors, reviewers, and editors in HRD.",
    venue: "Human Resource Development Review",
    doi: "https://doi.org/10.1177/15344843261445531",
    tag: "Online first",
    plain:
      "Offers authors, reviewers, and editors clear guidance on when using AI tools in review and conceptual research is acceptable, questionable, or off-limits.",
  },
  {
    citation:
      "Crocco, O. S., & Rockett, A. (2026). Leading learning amidst conflict: A qualitative study of leaders of training and education organizations in post-coup Myanmar.",
    venue: "New Horizons in Adult Education and Human Resource Development",
    doi: "https://doi.org/10.1177/19394225261464253",
    tag: "Online first",
    plain:
      "Six community-based leaders in rural Myanmar describe how they keep adult training going after the 2021 coup, drawing on relationships, community legitimacy, and perseverance.",
  },
  {
    citation:
      "Crocco, O. S., Aroonsri, P., & Isna, N. (2025). Communicating a vision for human resource development in Southeast Asia: A thematic analysis of the speeches of ASEAN secretaries-general.",
    venue: "Human Resource Development International, 28(4), 543–566",
    doi: "https://doi.org/10.1080/13678868.2024.2441089",
    tag: "2025",
    plain:
      "Reads 132 speeches by three ASEAN secretaries-general to trace how their words shaped who counts in developing Southeast Asia's workforce, and why.",
  },
  {
    citation:
      "Aroonsri, P., & Crocco, O. S. (2024). Workplace learning and information exchange among gig workers: Crowdsourcing and the social media advantage.",
    venue: "Journal of Workplace Learning, 36(1), 77–95",
    doi: "https://doi.org/10.1108/JWL-03-2023-0049",
    tag: "2024",
    plain:
      "Gig workers in Thailand, shut out of formal training, use social media groups to teach each other the job, often helping rivals even when it costs them.",
  },
  {
    citation:
      "Crocco, O. S., & Tkachenko, O. (2022). Regional human resource development: The case of Southeast Asia and ASEAN.",
    venue: "Human Resource Development International, 25(1), 40–58",
    doi: "https://doi.org/10.1080/13678868.2020.1858261",
    tag: "Award winner",
    plain:
      "Examines how Southeast Asian nations build human capability together through ASEAN, and names and defines a new concept: regional human resource development.",
  },
];

// "At a glance" credibility stats — figure on top, label beneath.
const stats = [
  { figure: "5", label: "books published or forthcoming" },
  { figure: "50+", label: "scholarly publications" },
  { figure: "Associate Editor", label: "Human Resource Development Review", small: true },
  { figure: "4", label: "research awards (AHRD, UFHRD, Emerald)" },
  { figure: "16", label: "countries of research & teaching" },
];

// "Beyond the research" — a taste of the site's more distinctive corners.
// Blurbs drawn from each page's own copy.
const distinctive = [
  {
    label: "Notes",
    href: "/notes",
    blurb:
      "Ideas, notes from Southeast Asia, how the research gets done, and short takes on books.",
  },
  {
    label: "Tools",
    href: "/tools",
    blurb:
      "Small, free tools I build for the day-to-day work of research, each one open to inspect.",
  },
  {
    label: "Poetry of Work",
    href: "/poetry-of-work",
    blurb:
      "A weekly public-domain poem paired with a photograph, on work, craft, and vocation.",
  },
];

const featuredBook = {
  title: "Developing Human Resources in Southeast Asia",
  subtitle: "A Holistic Framework for the ASEAN Community",
  publisher: "Palgrave Macmillan, 2021",
  description:
    "The first systematic framework for understanding human resource development at the regional level in Southeast Asia. Argues that ASEAN's HRD ecosystem is a complex adaptive system shaped by the ASEAN Way of musjawarah and mufakat, or deliberation and consensus.",
};
---

<BaseLayout>
  <PersonSchema slot="head" />

  {/* ============================================================ HERO ============================================================ */}
  <section class=" border-b border-[var(--color-border)] relative overflow-hidden">
    <div class="wrap py-24 md:py-36 relative">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
        <div class="md:col-span-8">
          <h1 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] font-semibold tracking-tight mb-10 leading-[0.95]">
            Oliver S.<br />Crocco
          </h1>
          <p class="font-display text-2xl md:text-[1.875rem] leading-[1.3] text-[var(--color-text)] mb-10 max-w-3xl">
            {SITE.positioning}
          </p>
          <p class="text-[var(--color-text-muted)] text-lg leading-relaxed max-w-xl mb-10">
            I'm Associate Professor of Leadership and Human Resource Development at <a href={AUTHOR.lsuProfileUrl}>Louisiana State University</a> and was {AUTHOR.visitingRole} at {AUTHOR.visitingInstitutionLong} ({AUTHOR.visitingYears}). My work brings the lens of adult learning and human development to questions of leadership and the changing nature of work, across organizations, institutions, and cultural contexts.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/books" class="btn btn-primary">Read my books</a>
            <a href="/publications" class="btn btn-ghost">Browse publications</a>
          </div>
        </div>

        <aside class="md:col-span-4 md:pt-2">
          <img
            src="/headshot-800.jpg"
            srcset="/headshot-400.jpg 400w, /headshot-800.jpg 800w, /headshot-1200.jpg 1200w"
            sizes="(max-width: 768px) 100vw, 33vw"
            alt="Oliver S. Crocco"
            width="800"
            height="1200"
            fetchpriority="high"
            class="w-full aspect-[3/4] object-cover rounded shadow-xl border border-[var(--color-border-strong)] mb-8"
          />
          <p class="eyebrow mb-3">At a glance</p>
          <ul class="space-y-2 text-[0.9375rem] leading-snug text-[var(--color-text-muted)]">
            {stats.map((stat) => (
              <li>
                {stat.small
                  ? <>{stat.figure}, <i>{stat.label}</i></>
                  : <>{stat.figure} {stat.label}</>}
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  {/* ============================================================ FEATURED BOOK ============================================================ */}
  <section class="border-b border-[var(--color-border)] bg-[var(--color-paper-warm)]">
    <div class="wrap py-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
        <div class="md:col-span-4">
          <img
            src="/book-covers/developing-human-resources-southeast-asia-800.jpg"
            srcset="/book-covers/developing-human-resources-southeast-asia-400.jpg 400w, /book-covers/developing-human-resources-southeast-asia-800.jpg 800w, /book-covers/developing-human-resources-southeast-asia-1200.jpg 1200w"
            sizes="(max-width: 768px) 100vw, 33vw"
            alt="Cover of Developing Human Resources in Southeast Asia: A Holistic Framework for the ASEAN Community"
            width="800"
            height="1186"
            loading="lazy"
            class="aspect-[2/3] w-full object-cover rounded shadow-2xl border border-black/20"
          />
        </div>
        <div class="md:col-span-8">
          <p class="eyebrow mb-4">Featured book</p>
          <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-3">
            {featuredBook.title}
          </h2>
          <p class="font-display text-xl text-[var(--color-text-muted)] italic mb-2">
            {featuredBook.subtitle}
          </p>
          <p class="text-sm text-[var(--color-text-soft)] mb-6">{featuredBook.publisher}</p>
          <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-8 max-w-2xl">
            {featuredBook.description}
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/books" class="btn btn-primary">All books</a>
            <a href="https://link.springer.com/book/10.1007/978-3-030-79697-6" class="btn btn-ghost">View on Palgrave</a>
          </div>
        </div>
      </div>

      {/* NEW RELEASE — sits under the featured book, updated when a new title lands. */}
      <div class="mt-16 pt-10 border-t border-[var(--color-border)] grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-2">
          <img
            src="/book-covers/foundations-of-leadership-development-400.jpg"
            srcset="/book-covers/foundations-of-leadership-development-400.jpg 400w, /book-covers/foundations-of-leadership-development-800.jpg 800w"
            sizes="(max-width: 768px) 40vw, 15vw"
            alt="Cover of Foundations of Leadership Development: The Self-Leadership Journey"
            width="400"
            height="606"
            loading="lazy"
            class="aspect-[2/3] w-full object-cover rounded shadow-lg border border-black/20"
          />
        </div>
        <div class="md:col-span-10">
          <p class="eyebrow mb-3">Just published</p>
          <p class="font-display text-2xl font-semibold tracking-tight mb-2">
            Foundations of Leadership Development: The Self-Leadership Journey
          </p>
          <p class="text-[var(--color-text-muted)] text-lg leading-relaxed max-w-2xl mb-6">
            A leadership development textbook written with Tomika W. Greer and Edward A. Gibbons III, out now from Palgrave Macmillan. It builds from self-leadership outward, through self-awareness, wellness, motivation, resilience, communication, relationships, and leading across cultures.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/books#foundations-of-leadership-development" class="btn btn-ghost">More on the book</a>
            <a href="https://link.springer.com/book/10.1007/978-3-032-28042-8" class="btn btn-ghost">View on Palgrave</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================ FIELD PHOTO SECTION BREAK (G) ============================================================ */}
  <figure class="relative">
    <img
      src="/bangkok-sunset-1600.jpg"
      srcset="/bangkok-sunset-800.jpg 800w, /bangkok-sunset-1600.jpg 1600w, /bangkok-sunset-2400.jpg 2400w"
      sizes="100vw"
      alt="Bangkok at sunset"
      class="w-full h-[45vh] md:h-[65vh] object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent"></div>
    <figcaption class="absolute bottom-6 left-6 md:bottom-10 md:left-12 text-white">
      <p class="font-display text-base md:text-lg italic">Bangkok, at dusk</p>
    </figcaption>
  </figure>

  {/* ============================================================ THREE STREAMS — DARK SECTION (B) ============================================================ */}
  <section class="section-dark border-y border-black/40">
    <div class="wrap py-28">
      <div class="max-w-2xl mb-14">
        <h2 class="font-display text-4xl md:text-5xl font-semibold tracking-tight mb-6 text-white leading-[1.1]">
          Three streams that interweave
        </h2>
        <p class="text-lg leading-relaxed">
          My scholarship moves between regional comparative work, the development of leaders and adults across cultures, and the rapidly shifting nature of work itself.
        </p>
      </div>

      <div>
        <StreamsBraid id="streams-home" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mt-3">
        {RESEARCH_THEMES.map((theme) => (
          <article class="relative">
            <div class="h-[2px] mb-6" style={`background: ${theme.color};`}></div>
            <h3 class="font-display text-2xl font-semibold mb-4 leading-tight text-white">
              {theme.title}
            </h3>
            <p class="text-[0.9375rem] leading-relaxed">
              {theme.summary}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================ SELECTED PUBLICATIONS ============================================================ */}
  <section class="border-b border-[var(--color-border)]">
    <div class="wrap py-24">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14">
        <div class="max-w-xl">
          <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-5">
            Selected publications
          </h2>
          <p class="text-[var(--color-text-muted)] text-lg leading-relaxed">
            A selection of articles that capture some of the highlights of my work. Please see the publications page for all my work.
          </p>
        </div>
        <a href="/publications" class="btn btn-ghost self-start md:self-end whitespace-nowrap">
          All publications
        </a>
      </div>

      <ol class="divide-y divide-[var(--color-border)]">
        {featuredPubs.map((pub) => (
          <li class="py-7 max-w-4xl">
            <div>
              <p class="font-display text-lg leading-snug text-[var(--color-text)] mb-1">
                {pub.citation}
              </p>
              <p class="text-sm text-[var(--color-text-muted)] mb-2">
                <i>{pub.venue}</i>{!/^\d{4}$/.test(pub.tag) && <>. {pub.tag}.</>}
              </p>
              {pub.plain && (
                <p class="text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed mb-2 max-w-2xl">
                  {pub.plain}
                </p>
              )}
              <a href={pub.doi} class="text-sm text-[var(--color-ink)] tracking-tight">
                {pub.doi.replace("https://", "")}
              </a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ============================================================ BEYOND THE RESEARCH — DISTINCTIVE SECTIONS ============================================================ */}
  <section class="border-b border-[var(--color-border)] bg-[var(--color-paper-warm)]">
    <div class="wrap py-24">
      <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight mb-6">
        Also on this site
      </h2>
      <ul class="divide-y divide-[var(--color-border-strong)] border-y border-[var(--color-border-strong)]">
        {distinctive.map((item) => (
          <li class="py-5 grid grid-cols-1 md:grid-cols-12 gap-1 md:gap-8 items-baseline">
            <a href={item.href} class="md:col-span-3 font-display text-xl font-semibold text-[var(--color-text)]">
              {item.label}
            </a>
            <p class="md:col-span-9 text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed">
              {item.blurb}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Fleuron />

  {/* ============================================================ CTA ============================================================ */}
  <section>
    <div class="wrap py-24">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-5">
          For invitations to collaborate, discuss, or learn more
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-8">
          I'm available to collaborate on research with scholars and practitioners working on similar questions. I am also open to speak, conduct workshops, or provide journalistic comment.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={`mailto:${AUTHOR.email}`} class="btn btn-primary">
            {AUTHOR.email}
          </a>
          <a href="/contact" class="btn btn-ghost">Other ways to reach me</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
