---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="border-b border-[var(--color-border)]">
    <div class="wrap py-32 md:py-40 text-center">
      <p class="eyebrow mb-6">404</p>
      <h1 class="font-display text-5xl md:text-7xl font-semibold tracking-tight mb-6">
        Page not found
      </h1>
      <p class="font-display text-xl text-[var(--color-text-muted)] leading-snug max-w-xl mx-auto mb-10">
        The page you're looking for doesn't exist on this site — or it may have moved during the recent rebuild.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/notes" class="btn btn-ghost">Browse writing</a>
        <a href="/publications" class="btn btn-ghost">Publications</a>
      </div>
    </div>
  </section>
</BaseLayout>
