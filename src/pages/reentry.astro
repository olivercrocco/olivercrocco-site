---
import BaseLayout from "../layouts/BaseLayout.astro";

const tools = [
  {
    step: "1",
    name: "Resume Builder",
    href: "/resume-builder/",
    action: "Build your resume",
    lede: "Answer one question at a time and get a resume that hiring software can read.",
    points: [
      "Counts the work you did while incarcerated as real experience",
      "Certifications offered in Louisiana prisons are one tap away",
      "Download a Word file, print it, or copy it into online applications",
      "Writes a first draft of a cover letter from your resume",
    ],
    repo: "https://github.com/olivercrocco/reentry-resume-builder",
  },
  {
    step: "2",
    name: "Interview Practice",
    href: "/interview-practice/",
    action: "Practice your interview",
    lede: "Get your answer about your conviction ready, then practice common questions out loud.",
    points: [
      "Builds your answer about your conviction in five short parts",
      "Can start \"Tell me about yourself\" from your saved resume",
      "19 practice questions with a timer and tips",
      "Prints a one-page sheet to take to the interview",
    ],
    repo: "https://github.com/olivercrocco/interview-practice",
  },
  {
    step: "3",
    name: "First Paycheck",
    href: "/first-paycheck/",
    action: "Plan your first paycheck",
    lede: "See what a job will actually pay after taxes, and plan the costs that come first.",
    points: [
      "Take-home pay after federal and Louisiana taxes",
      "Monthly costs in the order to pay them, starting with required payments",
      "Shows what is left over or short, and what to do next",
      "Explains every line on a paystub",
    ],
    repo: "https://github.com/olivercrocco/first-paycheck",
  },
];

const goodToKnow = [
  { title: "Free", body: "No cost, no sign-up, and no account." },
  { title: "Private", body: "What you type stays on your device. Nothing is sent anywhere or saved unless you choose to save it." },
  { title: "Easy to read", body: "Plain language, one step at a time, and a button on every step that reads it out loud." },
  { title: "Works anywhere", body: "On a phone, tablet, or computer, and without the internet once downloaded." },
];
---

<BaseLayout
  title="Reentry Toolkit"
  description="Free, plain-language tools for formerly incarcerated individuals and the programs that support them: a resume builder, interview practice, and a first paycheck planner. Each runs in the browser, works offline, and stores nothing."
>
  {/* HERO */}
  <section class="border-b border-[var(--color-border)] paper-grain">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow mb-5">Reentry Toolkit</p>
      <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight mb-8 leading-[1.05]">
        Free tools for getting back to work
      </h1>
      <p class="font-display text-xl md:text-2xl text-[var(--color-text-muted)] leading-snug max-w-3xl">
        Plain-language tools for formerly incarcerated individuals and the programs that
        support them. Use them in this order, or start with the one you need.
      </p>
    </div>
  </section>

  {/* THE THREE TOOLS */}
  {tools.map((tool, i) => (
    <section
      class:list={[
        "border-b border-[var(--color-border)]",
        i % 2 === 0 && "bg-[var(--color-paper-warm)]",
      ]}
    >
      <div class="wrap py-16 md:py-20">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
          <div class="md:col-span-5">
            <p class="eyebrow mb-4">Step {tool.step}</p>
            <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-4 leading-tight">
              {tool.name}
            </h2>
            <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-6">
              {tool.lede}
            </p>
            <a href={tool.href} class="btn btn-primary">{tool.action} →</a>
          </div>
          <div class="md:col-span-7">
            <ul class="space-y-3">
              {tool.points.map((p) => (
                <li class="flex gap-3 text-[var(--color-text)] text-[1.0625rem] leading-relaxed">
                  <span class="text-[var(--color-gold)] mt-1.5 shrink-0" aria-hidden="true">▪</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}

  {/* GOOD TO KNOW */}
  <section class="border-b border-[var(--color-border)]">
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow mb-4">Good to know</p>
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-10 max-w-2xl">
        Every tool works the same way
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {goodToKnow.map((g) => (
          <article class="border-t border-[var(--color-border-strong)] pt-5">
            <h3 class="font-display text-xl font-semibold mb-2 leading-tight">{g.title}</h3>
            <p class="text-[var(--color-text-muted)] text-[0.9375rem] leading-relaxed">{g.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* FOR PROGRAMS */}
  <section class="border-b border-[var(--color-border)] bg-[var(--color-paper-warm)]">
    <div class="wrap py-16 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
        <div class="md:col-span-5">
          <p class="eyebrow mb-4">For programs and staff</p>
          <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight mb-4 leading-tight">
            Use them in your classes
          </h2>
          <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-6">
            I built these for a pre-release employment skills course in Louisiana. They are
            free for any program to use, share, and adapt.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/reentry/reentry-toolkit.zip" class="btn btn-primary" download>Download all three →</a>
            <a href="/contact" class="btn btn-ghost">Get in touch →</a>
          </div>
        </div>
        <div class="md:col-span-7 space-y-7 text-[var(--color-text)] leading-relaxed">
          <div>
            <h3 class="font-display text-xl font-semibold mb-2 leading-tight">Without the internet</h3>
            <p>
              The download holds each tool as a single file. Copy them to a laptop or a USB
              drive and open them in any browser. Nothing needs to be installed.
            </p>
          </div>
          <div>
            <h3 class="font-display text-xl font-semibold mb-2 leading-tight">In class</h3>
            <p>
              Interview Practice works well in pairs: one person reads the question card, the
              other answers while the timer runs. The resume, the interview sheet, and the
              budget plan all print, so participants leave with paper copies.
            </p>
          </div>
          <div>
            <h3 class="font-display text-xl font-semibold mb-2 leading-tight">On shared computers</h3>
            <p>
              Nothing is kept in the browser. Remind participants to use "Clear everything"
              when they finish and to delete any work they saved to the computer.
            </p>
          </div>
          <div>
            <h3 class="font-display text-xl font-semibold mb-2 leading-tight">In another state</h3>
            <p>
              The certification lists and the tax figures are for Louisiana; everything else
              applies anywhere. Each tool is open source under the MIT license, and its README
              explains which lists to change:
              <a class="underline" href={tools[0].repo}>resume builder</a>,
              <a class="underline" href={tools[1].repo}>interview practice</a>,
              <a class="underline" href={tools[2].repo}>first paycheck</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
