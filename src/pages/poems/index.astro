---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const all = await getCollection("poems", ({ data }) => !data.draft);
const poems = all.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.order - b.data.order
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long" });

// First line of each poem, for the index.
const firstLine = (body: string | undefined) =>
  (body ?? "").split("\n").map((l) => l.trim()).find((l) => l.length > 0) ?? "";
---

<BaseLayout
  title="Poems"
  description="Poems by Oliver S. Crocco: short, placed, and dated. Work, family, and the places in between."
>
  <section class="border-b border-[var(--color-border)] paper-grain">
    <div class="wrap py-20 md:py-28">
      <p class="eyebrow mb-5">Poems</p>
      <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight mb-6 max-w-3xl leading-[1.05]">
        Poems
      </h1>
      <p class="font-display text-xl md:text-2xl text-[var(--color-text-muted)] leading-snug max-w-2xl italic">
        Short, placed, and dated. Each one with a line or two underneath about where it came from.
      </p>
    </div>
  </section>

  <section class="border-b border-[var(--color-border)]">
    <div class="wrap-narrow py-16">
      <ul class="list-none m-0 p-0">
        {poems.map((poem) => (
          <li class="py-7 border-t border-[var(--color-border)] first:border-t-0">
            <div class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-[var(--color-text-soft)] flex items-center gap-4 mb-2">
              {poem.data.place && (
                <span class="text-[var(--color-gold)] font-medium">{poem.data.place}</span>
              )}
              <span>{formatDate(poem.data.date)}</span>
            </div>
            <h2 class="font-display text-2xl md:text-[1.75rem] font-semibold leading-[1.2] tracking-tight mb-2">
              <a
                href={`/poems/${poem.id}/`}
                class="text-[var(--color-text)] hover:text-[var(--color-ink)] no-underline"
              >
                {poem.data.title}
              </a>
            </h2>
            <p class="font-display text-[1.0625rem] text-[var(--color-text-muted)] leading-relaxed mt-2 italic">
              {firstLine(poem.body)}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap-narrow py-16">
      <div class="prose max-w-3xl">
        <p>
          These are my own poems. For the weekly public-domain poems on work and vocation, see
          <a href="/poetry-of-work">The Poetry of Work</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
