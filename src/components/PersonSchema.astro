---
/**
 * JSON-LD structured data describing Oliver as a Person.
 *
 * Goes in the <head> of the homepage and About page (the two pages that
 * are "about Oliver" canonically). Helps Google understand the entity,
 * surface knowledge-panel info, and link search results back to authoritative
 * profiles (ORCID, Google Scholar, LinkedIn).
 *
 * Schema reference: https://schema.org/Person
 */

import { AUTHOR, SITE, SOCIAL, PERSON_ID } from "../site.config";

interface Props {
  /** On /about, wrap the Person in a ProfilePage so the page reads as his profile. */
  profilePage?: boolean;
}
const { profilePage = false } = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": PERSON_ID,
  name: AUTHOR.name,
  alternateName: [
    `${AUTHOR.nickname} Crocco`,
    "Oliver Crocco",
    "Oliver Stephen Crocco",
    "Oliver S. Crocco, EdD",
  ],
  givenName: "Oliver",
  familyName: "Crocco",
  honorificSuffix: "EdD",
  jobTitle: AUTHOR.role,
  description: SITE.description,
  url: SITE.url,
  email: `mailto:${AUTHOR.email}`,
  image: `${SITE.url}/headshot-1200.jpg`,
  worksFor: {
    "@type": "CollegeOrUniversity",
    name: AUTHOR.institution,
    url: "https://www.lsu.edu",
    department: {
      "@type": "Organization",
      name: AUTHOR.department,
    },
  },
  affiliation: [
    {
      "@type": "CollegeOrUniversity",
      name: AUTHOR.institution,
      url: "https://www.lsu.edu",
    },
  ],
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "The George Washington University",
      url: "https://www.gwu.edu",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Harvard University",
      url: "https://www.harvard.edu",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Whitworth University",
      url: "https://www.whitworth.edu",
    },
  ],
  knowsAbout: [
    "Human Resource Development",
    "Human Capital Development in Southeast Asia",
    "ASEAN",
    "Global Leadership",
    "Leadership Development",
    "Adult Learning",
    "Transformative Learning",
    "Workplace Learning",
    "The Changing Nature of Work",
    "Gig Work",
    "Responsible AI in Research",
    "Thailand",
    "Myanmar",
  ],
  sameAs: [
    SOCIAL.orcid,
    SOCIAL.wikidata,
    SOCIAL.googleScholar,
    SOCIAL.linkedin,
    SOCIAL.twitter,
    AUTHOR.lsuProfileUrl,
  ].filter(Boolean),
};

const schema = profilePage
  ? {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      url: `${SITE.url}/about/`,
      mainEntity: personSchema,
    }
  : personSchema;
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
